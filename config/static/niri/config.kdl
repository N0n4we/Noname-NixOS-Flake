input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.0
    }
    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse
    warp-mouse-to-focus
}

output "DSI-1" {
    scale 2.0
    mode "1200x1920"
    transform "270"
}

output "HDMI-A-1" {
    scale 2.0
}

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    GDK_BACKEND "wayland,x11"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    DISPLAY ":0"
}

cursor {
    xcursor-size 24
    hide-when-typing
}

overview {
    workspace-shadow {
        off
    }
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

layout {
    gaps 12
    center-focused-column "never"

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        off
        width 2
        active-color "#6b6566"
        inactive-color "#505050"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshot_%d-%b_%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "alacritty" "--daemon"
spawn-sh-at-startup "sleep 0.5 && mako"
spawn-at-startup "wlsunset" "-s" "00:00" "-t" "2500"
spawn-at-startup "fcitx5" "-d" "--replace"
spawn-at-startup "blueman-applet"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "--all"
spawn-at-startup "nautilus" "--gapplication-service"
spawn-at-startup "xwayland-satellite"

binds {
    // 基本操作
    Mod+9 repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // 应用启动
    Mod+A { spawn "alacritty" "msg" "create-window" "-e" "bash" "-i"; }
    Mod+T { spawn "alacritty" "-e" "bash" "-i"; }
    Mod+B { spawn "xdg-open" "https://"; }
    Mod+M { spawn "alacritty" "msg" "create-window" "-e" "btop"; }
    Mod+E { spawn "alacritty" "msg" "create-window" "-e" "bash" "-ic" "y"; }
    Mod+C { spawn-sh "alacritty msg create-window -e bash -ic 'aichat -s $(date +%Y-%m-%d_%H:%M:%S) -r brief; exit'"; }
    Mod+X { spawn-sh "notify-send \"$(~/.local/bin/status)\""; }
    Mod+S { spawn "alacritty" "msg" "create-window" "-e" "bash" "-ic" "nix-search; exit"; }
    Mod+V { spawn "alacritty" "msg" "create-window" "-e" "bash" "-ic" "clip; exit"; }
    Mod+D { spawn "alacritty" "msg" "create-window" "-e" "bash" "-ic" "app; exit"; }
    Mod+Z { spawn "hyprpicker"; }

    // OCR
    Mod+Shift+E { spawn-sh "grim -g \"$(slurp)\" - | tesseract stdin stdout -l eng | wl-copy"; }
    Mod+Shift+C { spawn-sh "grim -g \"$(slurp)\" - | tesseract stdin stdout -l chi_sim | tr -d '[:space:]' | wl-copy"; }
    Mod+Shift+D { spawn-sh "grim -g \"$(slurp)\" - | tesseract stdin stdout -l jpn | tr -d '[:space:]' | wl-copy"; }

    // 焦点 / 导航
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Alt+Tab       { focus-window-previous; }
    Alt+Shift+Tab { focus-window-previous; }

    // 调整窗口大小 (resize)
    Mod+Shift+H { set-column-width "-10%"; }
    Mod+Shift+L { set-column-width "+10%"; }
    Mod+Shift+K { set-window-height "+10%"; }
    Mod+Shift+J { set-window-height "-10%"; }
    Mod+Shift+Left  { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }
    Mod+Shift+Up    { set-window-height "+10%"; }
    Mod+Shift+Down  { set-window-height "-10%"; }

    // 工作区内移动窗口/列
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // 概览 / 列宽
    Mod+Q { toggle-overview; }
    Mod+Grave { toggle-overview; }
    Mod+0 { reset-window-height; }
    Mod+W { switch-focus-between-floating-and-tiling; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // output 切换
    Mod+Tab       { focus-monitor-next; }
    Mod+Shift+Tab { focus-monitor-previous; }

    // 居中 / 新终端
    Mod+Space { center-column; }
    Mod+Return { spawn "alacritty"; }

    // 截图 & 录屏
    Mod+Shift+S { spawn "bash" "-ic" "ScreenShot.sh --area"; }
    Mod+Shift+A { spawn "bash" "-ic" "ScreenShot.sh --show"; }
    Mod+Ctrl+S  { spawn "bash" "-ic" "ScreenRecord.sh --area"; }
    Mod+Ctrl+A  { spawn "bash" "-ic" "AudioRecord.sh --all"; }
    Print       { spawn-sh "grim - | wl-copy"; }
    Shift+Print { spawn-sh "grim -g \"$(slurp -d)\" - | wl-copy"; }

    // 系统控制
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "bash" "-ic" "Volume.sh --inc"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "bash" "-ic" "Volume.sh --dec"; }
    XF86AudioMute         allow-when-locked=true { spawn "bash" "-ic" "Volume.sh --toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "bash" "-ic" "Volume.sh --toggle-mic"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "bash" "-ic" "Brightness.sh --inc"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "bash" "-ic" "Brightness.sh --dec"; }
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "bash" "-ic" "BrightnessKbd.sh --inc"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "bash" "-ic" "BrightnessKbd.sh --dec"; }
    XF86AudioPlay  allow-when-locked=true { spawn "bash" "-ic" "MediaCtrl.sh --pause"; }
    XF86AudioPause allow-when-locked=true { spawn "bash" "-ic" "MediaCtrl.sh --pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "bash" "-ic" "MediaCtrl.sh --nxt"; }
    XF86AudioPrev  allow-when-locked=true { spawn "bash" "-ic" "MediaCtrl.sh --prv"; }
    XF86AudioStop  allow-when-locked=true { spawn "bash" "-ic" "MediaCtrl.sh --stop"; }
    XF86Sleep      { spawn "systemctl" "suspend"; }
    XF86Rfkill     { spawn "bash" "-ic" "AirplaneMode.sh"; }
    Ctrl+Alt+L     { spawn "bash" "-ic" "LockScreen.sh"; }

    // 工作区
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    Mod+U { focus-workspace-up; }
    Mod+N { focus-workspace-down; }
    Mod+Ctrl+U { move-window-to-workspace-up; }
    Mod+Ctrl+N { move-window-to-workspace-down; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }

    // 鼠标滚轮切换工作区 / 列
    Mod+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // 退出 / 电源
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
