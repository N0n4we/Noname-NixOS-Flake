#!/usr/bin/env bash

if [ $# -eq 0 ]; then
    echo "Usage: $0 <path>"
    exit 1
fi

file="$1"

if [ ! -f "$file" ]; then
    echo "Error: file '$file' does not exist or is not a regular file"
    exit 1
fi

mime=$(file --mime-type -b "$file" 2>/dev/null)
if [ -z "$mime" ]; then
    echo "Warning: unable to determine file type, using application/octet-stream"
    mime="application/octet-stream"
fi

wl-copy -t "$mime" < "$file" 2>/dev/null
if [ $? -eq 0 ]; then
    echo "Copied '$file' (type: $mime) to clipboard"
else
    echo "Error: copy failed, please ensure wl-copy is installed and a Wayland session is running"
    exit 1
fi
