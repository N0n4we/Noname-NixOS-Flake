#!/usr/bin/env bash

set -euo pipefail

emoji_pythonpath() {
  local paths=()

  shopt -s nullglob
  paths=(/nix/store/*-python3*-emoji-*/lib/python*/site-packages)
  shopt -u nullglob

  if [[ ${#paths[@]} -eq 0 ]]; then
    return 1
  fi

  (
    local IFS=:
    printf '%s' "${paths[*]}"
  )
}

emoji_list_from_python() {
  local pythonpath

  pythonpath=$(emoji_pythonpath) || return 1

  PYTHONPATH="${pythonpath}${PYTHONPATH:+:${PYTHONPATH}}" python3 - <<'PY'
import emoji

for char, meta in emoji.EMOJI_DATA.items():
    name = meta.get("en", "").strip(":").replace("_", " ")
    aliases = " ".join(
        alias.strip(":").replace("_", " ")
        for alias in meta.get("alias", [])
    )

    if not name:
        continue

    if aliases:
        print(f"{char} {name} {aliases}")
    else:
        print(f"{char} {name}")
PY
}

emoji_json_path() {
  local candidate

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] && {
      printf '%s\n' "$candidate"
      return 0
    }
  done < <(
    find \
      /run/current-system/sw \
      /etc/profiles/per-user/"${USER}" \
      /nix/store \
      -path '*/data/emoji.json' \
      -type f \
      -print 2>/dev/null
  )

  return 1
}

emoji_list_from_json() {
  local json_file

  json_file=$(emoji_json_path) || return 1
  jq -r '.[] | select(.char and .name) | "\(.char) \(.name)"' "$json_file"
}

generate_emoji_list() {
  emoji_list_from_python || emoji_list_from_json
}

selected=$(
  generate_emoji_list | LC_ALL=C sort -f -k2,2 | tv --source-output "{}" --no-remote
) || exit 0

emoji=${selected%% *}
[[ -n "$emoji" ]] || exit 0

printf '%s' "$emoji" | wl-copy
printf '%s\n' "$emoji"
